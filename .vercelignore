# Vercel ignore file
# Files and directories to exclude from deployment

# Development files
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (they'll be set in Vercel dashboard)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Documentation (optional - you can remove this if you want to include docs)
*.md
!README.md
